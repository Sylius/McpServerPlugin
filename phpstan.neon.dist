parameters:
    level: max
    # Guards the declared composer floor/ceiling: catches 8.3-only syntax
    # (typed class constants, #[\Override]) that would break PHP 8.2.
    phpVersion:
        min: 80200
        max: 80400
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
        - tests/Behat
        - tests/Unit

    ignoreErrors:
        - identifier: missingType.iterableValue
