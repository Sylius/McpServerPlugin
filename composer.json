{
    "name": "sylius/mcp-server-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin"
    ],
    "description": "Sylius MCP Server Plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "sylius/sylius": "^2.2",
        "symfony/mcp-bundle": "^0.15"
    },
    "require-dev": {
        "behat/behat": "^3.14 || 4.0.0-alpha1",
        "behat/mink": "^1.13",
        "behat/mink-browserkit-driver": "^2.3",
        "dmore/behat-chrome-extension": "^1.5",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink-debug-extension": "^2.2",
        "friends-of-behat/mink-extension": "^2.7 || 3.0.0-alpha1",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/variadic-extension": "^1.7",
        "matthiasnoback/symfony-config-test": "^5.1 || ^6.2",
        "matthiasnoback/symfony-dependency-injection-test": "^6.3",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^12.5",
        "sylius-labs/coding-standard": "^4.5",
        "sylius/test-application": "^2.1.0@alpha",
        "sylius/sylius-rector": "^3.9",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/property-info": "^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/flex": "^2.4",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.4"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "rector/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": false
        }
    },
    "extra": {
        "symfony": {
            "require": "^7.4 || ^8.0"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "Sylius\\McpServerPlugin\\": "src/",
            "Tests\\Sylius\\McpServerPlugin\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "security-checker security:check": "script"
        }
    }
}
